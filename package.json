{
  "name": "thesis-assistant",
  "version": "1.0.0",
  "private": true,
  "description": "Local thesis reference and live defense assistant",
  "type": "module",
  "main": "desktop/main.cjs",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
